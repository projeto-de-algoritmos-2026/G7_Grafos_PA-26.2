# Supabase API Configuration (opcional para Storage / Auth REST)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Supabase PostgreSQL Database URL (para o Prisma ORM)
# Obtenha em: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL="postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Server Configuration
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
